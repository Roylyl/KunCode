{
  "name": "kuncode-kunkun-ai",
  "displayName": "困困AI",
  "description": "KunCode内置的本地风格助手",
  "version": "2.0.0",
  "publisher": "kuncode",
  "license": "MIT",
  "engines": { "vscode": "*" },
  "main": "./extension.js",
  "scripts": {
    "test": "node --test test/extension.test.js test/corpus.test.js"
  },
  "enabledApiProposals": ["chatParticipantPrivate", "defaultChatParticipant", "chatProvider"],
  "activationEvents": ["onStartupFinished", "onChatParticipant:kuncode.kunkun"],
  "contributes": {
    "languageModelChatProviders": [
      { "vendor": "kuncode", "displayName": "Kunkun AI" }
    ],
    "chatParticipants": [
      {
        "id": "kuncode.kunkun",
        "name": "kunkun",
        "fullName": "Kunkun AI",
        "description": "KunCode本地场景语料与风格模拟助手",
        "isDefault": true,
        "commands": [
          { "name": "random", "description": "随机抽取一条困困语录" },
          { "name": "about", "description": "关于困困AI" }
        ],
        "modes": ["ask"]
      }
    ]
  },
  "categories": ["Other"]
}
